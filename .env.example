# PTZ Command - Environment Configuration
# Copy this file to .env and update with your settings

# PostgreSQL Database Connection
# Format: postgresql://username:password@host:port/database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ptz_command

# Shared server port (default: 3478)
PORT=3478

# Session signing secret for shared/multi-user deployments
SESSION_SECRET=change-this-before-sharing-the-app

# Independent key and stable key ID for encrypted device credentials
SECRET_ENCRYPTION_KEY=replace-with-at-least-32-random-characters
SECRET_ENCRYPTION_KEY_ID=local-v1

# JSON object of old key IDs to key material, used only during rotation
SECRET_ENCRYPTION_PREVIOUS_KEYS={}

# Cookie security mode: true, false, or auto
SESSION_COOKIE_SECURE=auto

# Trust only a known reverse proxy. Use loopback with the bundled Caddyfile.
PTZ_TRUST_PROXY=false

# Node Environment (development or production)
NODE_ENV=development
